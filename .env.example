# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/employee_management
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/employee_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/employee_management

NODE_ENV=development
